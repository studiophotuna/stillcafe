# ----- Supabase -----
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- App -----
# Public base URL of the deployed site (used for payment redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Email (optional) -----
# Sign up at resend.com, verify your domain, and get an API key.
# If not set, the system works fine without sending emails.
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=bookings@yourdomain.com
