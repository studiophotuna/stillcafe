# ----- Supabase (required) -----
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- App (required) -----
# Public base URL of the deployed site (used for payment redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Email (optional) -----
# Sign up at resend.com, verify your domain, and get an API key.
# If not set, the system works fine without sending emails.
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=bookings@yourdomain.com

# ----- Payments (optional) -----
# The recommended way to configure payment keys is in the admin panel
# (Settings > Payment providers), which stores them in the database and lets
# you run several providers at once. The variables below are only used as a
# fallback when a provider has no keys saved in the admin. Fill in only the
# provider(s) you use.

# Stripe — dashboard.stripe.com > Developers > API keys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal — developer.paypal.com > Apps & Credentials
# PAYPAL_CLIENT_ID=...
# PAYPAL_SECRET=...
# PAYPAL_WEBHOOK_ID=...
# PAYPAL_MODE=sandbox   # or "live"

# PayMongo (Philippines) — dashboard.paymongo.com > Developers
# PAYMONGO_SECRET_KEY=sk_test_...
# PAYMONGO_WEBHOOK_SECRET=whsk_...
